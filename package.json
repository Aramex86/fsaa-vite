{
  "name": "fsaa-vite",
  "packageManager": "pnpm@10.34.9",
  "version": "0.1.0",
  "private": true,
  "description": "FSAA boilerplate for plain React (Vite) — same layers, aliases and ESLint boundaries as the Next.js template; pages layer lives in src/pages with react-router",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^5",
    "eslint": "^9",
    "eslint-import-resolver-typescript": "^4",
    "eslint-plugin-fsaa": "0.1.1",
    "eslint-plugin-import": "^2",
    "typescript": "~5",
    "vite": "^7",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
